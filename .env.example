# Supabase (Database, Auth & RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service role key HANYA untuk backend / Pages Functions, JANGAN diekspos ke klien
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 (Media Storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=jejak-rona-media
MEDIA_PUBLIC_URL=https://media.jejakrona.com

# Cloudflare Pages & Deployment
DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your-hook-id
CF_API_TOKEN=your-cloudflare-api-token
CF_PROJECT_NAME=jejak-rona

# Public Site Configuration
PUBLIC_SITE_NAME="Jejak Rona"
PUBLIC_SITE_URL=http://localhost:4321
