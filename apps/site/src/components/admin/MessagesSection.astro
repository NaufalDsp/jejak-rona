---
// Component: MessagesSection
// Pesan Masuk dari Formulir Kontak Pembaca
---

<section
  class="hidden"
  id="messages-panel"
  aria-label="Pesan masuk formulir kontak">
  <div class="admin-card">
    <div class="admin-card__header">
      <div>
        <h2 class="admin-card__title">Pesan Masuk (Formulir Kontak)</h2>
        <span class="muted" style="font-size: 13px;"
          >Kiriman korespondensi dan gagasan dari pembaca situs.</span
        >
      </div>
    </div>

    <div id="messages-list" style="display: flex; flex-direction: column;">
      <div style="padding: 2rem; text-align: center; color: var(--sand-600);">
        Memuat pesan masuk…
      </div>
    </div>
  </div>
</section>
