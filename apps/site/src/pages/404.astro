---
import "@jejak-rona/tokens/tokens.css";
import { getSiteSettings } from "../lib/site-data";

const siteSettings = await getSiteSettings();
const bgPhoto =
  "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=80";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Halaman Tidak Ditemukan — {siteSettings.siteName}</title>
    <meta
      name="description"
      content="Halaman yang Anda tuju tidak ditemukan dalam arsip Jejak Rona."
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="error-hero">
      <div class="error-hero__media">
        <img
          src={bgPhoto}
          alt="Lanskap pantai Nusantara dalam kabut tenang"
          loading="eager"
          decoding="async"
        />
        <div class="error-hero__scrim"></div>
      </div>

      <div class="error-hero__content">
        <span class="error-badge">404 — JEJAK TERPUTUS</span>
        <h1 class="error-title">Halaman Tidak Ditemukan</h1>
        <p class="error-desc">
          Langkah Anda menuju ke sudut yang belum atau tidak lagi terpetakan
          dalam arsip ini.
        </p>
        <div class="error-actions">
          <a href="/" class="return-btn">Kembali ke Beranda</a>
        </div>
      </div>
    </main>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--ink-950, #12110d);
        color: var(--bone-50, #fcfbf8);
        font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
        overflow: hidden;
      }

      .error-hero {
        position: relative;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
      }

      .error-hero__media {
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      .error-hero__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .error-hero__scrim {
        position: absolute;
        inset: 0;
        background: radial-gradient(
          circle at center,
          rgba(18, 17, 13, 0.45) 0%,
          rgba(18, 17, 13, 0.85) 100%
        );
      }

      .error-hero__content {
        position: relative;
        z-index: 2;
        max-width: 640px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .error-badge {
        font-size: var(--text-small, 0.8125rem);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--sand-300, #ded4c5);
        margin-bottom: 1.25rem;
      }

      .error-title {
        font-family: var(--font-serif, "Playfair Display", Georgia, serif);
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 300;
        line-height: 1.1;
        color: var(--bone-50, #fcfbf8);
        margin-bottom: 1.25rem;
        letter-spacing: -0.015em;
      }

      .error-desc {
        font-size: 1.125rem;
        line-height: 1.6;
        color: var(--sand-200, #ede7de);
        margin-bottom: 2.5rem;
        max-width: 48ch;
      }

      .return-btn {
        display: inline-block;
        background: var(--bone-50, #fcfbf8);
        color: var(--ink-950, #12110d);
        text-decoration: none;
        padding: 0.85rem 2.25rem;
        font-size: 0.9375rem;
        letter-spacing: 0.04em;
        font-weight: 500;
        transition: opacity 0.15s ease;
      }

      .return-btn:hover {
        opacity: 0.9;
      }
    </style>
  </body>
</html>
