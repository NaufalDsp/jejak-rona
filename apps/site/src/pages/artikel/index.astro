---
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  getPublishedPosts,
  getAllPostTags,
  resolvePostCover,
} from "../../lib/site-data";

const posts = await getPublishedPosts();
const allTags = await getAllPostTags();
---

<SiteLayout
  title="Arsip Artikel"
  description="Kumpulan narasi visual, esai perjalanan, dan dokumentasi budaya Nusantara dalam ritme tenang.">
  <div class="articles-container">
    <header class="articles-header">
      <span class="articles-tagline">JURNAL & ARSIP</span>
      <h1 class="articles-title">Cerita yang Tinggal</h1>
      <p class="articles-intro">
        Menelusuri sudut-sudut kepulauan melalui keheningan lanskap, ketabahan
        kriya, dan narasi yang tak lekang oleh waktu.
      </p>

      {
        allTags.length > 0 && (
          <div class="tags-filter" aria-label="Filter berdasarkan topik">
            <button class="tag-btn active" data-tag="all">
              Semua
            </button>
            {allTags.map((tag) => (
              <button class="tag-btn" data-tag={tag}>
                {tag}
              </button>
            ))}
          </div>
        )
      }
    </header>

    <div class="view-switch-bar">
      <span class="post-count">{posts.length} Catatan Terkurasi</span>
      <div class="view-toggles" role="group" aria-label="Pilihan tampilan">
        <button
          id="toggle-list"
          class="view-toggle-btn active"
          type="button"
          aria-pressed="true">
          Daftar
        </button>
        <span aria-hidden="true" style="color: var(--sand-400);">/</span>
        <button
          id="toggle-grid"
          class="view-toggle-btn"
          type="button"
          aria-pressed="false">
          Grid
        </button>
      </div>
    </div>

    <!-- Tampilan Daftar (Default) -->
    <section id="articles-list-view" class="articles-list">
      {
        posts.map((post) => {
          const dateFormatted = new Date(post.publishedAt).toLocaleDateString(
            "id-ID",
            {
              day: "numeric",
              month: "short",
              year: "numeric",
            },
          );

          return (
            <article class="article-row" data-tags={post.tags.join(",")}>
              <a href={`/artikel/${post.slug}`} class="article-row__link">
                <time class="article-row__date" datetime={post.publishedAt}>
                  {dateFormatted}
                </time>
                <div class="article-row__content">
                  <h2 class="article-row__title">{post.title}</h2>
                  <p class="article-row__excerpt">{post.excerpt}</p>
                </div>
                <div class="article-row__meta">
                  <span class="reading-time">
                    {post.readingTimeMinutes} mnt baca
                  </span>
                  <div class="article-row__tags">
                    {post.tags.map((t) => (
                      <span class="tag-pill">{t}</span>
                    ))}
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </section>

    <!-- Tampilan Grid (Dua kolom, tanpa kotak/border/shadow sesuai design.md 6.8) -->
    <section id="articles-grid-view" class="articles-grid" hidden>
      {
        posts.map((post) => {
          const dateFormatted = new Date(post.publishedAt).toLocaleDateString(
            "id-ID",
            {
              day: "numeric",
              month: "short",
              year: "numeric",
            },
          );

          return (
            <article class="grid-item" data-tags={post.tags.join(",")}>
              <a href={`/artikel/${post.slug}`} class="grid-item__link">
                <div class="grid-item__media">
                  <img
                    src={resolvePostCover(post.slug, post.coverImageUrl)}
                    alt={post.title}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="grid-item__meta">
                  <time datetime={post.publishedAt}>{dateFormatted}</time>
                  <span>•</span>
                  <span>{post.readingTimeMinutes} mnt</span>
                </div>
                <h2 class="grid-item__title">{post.title}</h2>
                <p class="grid-item__excerpt">{post.excerpt}</p>
              </a>
            </article>
          );
        })
      }
    </section>
  </div>
</SiteLayout>

<script>
  const toggleList = document.getElementById(
    "toggle-list",
  ) as HTMLButtonElement | null;
  const toggleGrid = document.getElementById(
    "toggle-grid",
  ) as HTMLButtonElement | null;
  const listView = document.getElementById("articles-list-view");
  const gridView = document.getElementById("articles-grid-view");
  const tagBtns = document.querySelectorAll<HTMLButtonElement>(".tag-btn");

  toggleList?.addEventListener("click", () => {
    toggleList.classList.add("active");
    toggleList.setAttribute("aria-pressed", "true");
    toggleGrid?.classList.remove("active");
    toggleGrid?.setAttribute("aria-pressed", "false");
    if (listView) listView.hidden = false;
    if (gridView) gridView.hidden = true;
  });

  toggleGrid?.addEventListener("click", () => {
    toggleGrid.classList.add("active");
    toggleGrid.setAttribute("aria-pressed", "true");
    toggleList?.classList.remove("active");
    toggleList?.setAttribute("aria-pressed", "false");
    if (listView) listView.hidden = true;
    if (gridView) gridView.hidden = false;
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      tagBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const selected = btn.dataset.tag || "all";

      const rows = document.querySelectorAll<HTMLElement>(
        ".article-row, .grid-item",
      );
      rows.forEach((row) => {
        const itemTags = (row.dataset.tags || "").split(",");
        if (selected === "all" || itemTags.includes(selected)) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  .articles-container {
    max-width: var(--container-wide, 1140px);
    margin: 0 auto;
    padding: calc(var(--header-height, 68px) + 3rem) var(--space-6, 1.5rem) 6rem;
  }

  .articles-header {
    border-bottom: 1px solid var(--sand-300, #ded4c5);
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .articles-tagline {
    font-size: var(--text-small, 0.8125rem);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sand-600, #736b5e);
    display: block;
    margin-bottom: 0.75rem;
  }

  .articles-title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--ink-950, #12110d);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .articles-intro {
    font-size: var(--text-body, 1.0625rem);
    color: var(--ink-700, #3d3a33);
    line-height: 1.7;
    max-width: 60ch;
    margin: 0 0 2rem;
  }

  .tags-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--sand-300, #ded4c5);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: var(--text-small, 0.8125rem);
    color: var(--ink-700, #3d3a33);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tag-btn:hover {
    border-color: var(--ink-950, #12110d);
    color: var(--ink-950, #12110d);
  }

  .tag-btn.active {
    background: var(--ink-950, #12110d);
    border-color: var(--ink-950, #12110d);
    color: var(--bone-50, #fcfbf8);
  }

  .view-switch-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    font-size: var(--text-small, 0.8125rem);
    color: var(--sand-600, #736b5e);
  }

  .view-toggles {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .view-toggle-btn {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    font-size: var(--text-small, 0.8125rem);
    color: var(--sand-600, #736b5e);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .view-toggle-btn.active {
    color: var(--ink-950, #12110d);
    font-weight: 600;
  }

  /* 6.8 Daftar Tampilan Baris Panjang */
  .articles-list {
    display: flex;
    flex-direction: column;
  }

  .article-row {
    border-top: 1px solid var(--sand-200, #ede7de);
    transition: background-color 0.15s ease;
  }

  .article-row:last-child {
    border-bottom: 1px solid var(--sand-200, #ede7de);
  }

  .article-row__link {
    display: grid;
    grid-template-columns: 140px 1fr 180px;
    align-items: baseline;
    gap: 2rem;
    padding: 2rem 0;
    text-decoration: none;
    color: inherit;
  }

  .article-row:hover {
    background-color: rgba(222, 212, 197, 0.15);
  }

  .article-row__date {
    font-size: var(--text-small, 0.8125rem);
    color: var(--sand-600, #736b5e);
    font-variant-numeric: tabular-nums;
  }

  .article-row__title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: var(--text-h3, 1.375rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-950, #12110d);
    margin: 0 0 0.5rem;
    transition: color 0.15s ease;
  }

  .article-row:hover .article-row__title {
    color: var(--ember-600, #b83d1b);
  }

  .article-row__excerpt {
    font-size: var(--text-small, 0.875rem);
    color: var(--ink-700, #4d483f);
    line-height: 1.6;
    margin: 0;
    max-width: 65ch;
  }

  .article-row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .reading-time {
    font-size: 0.75rem;
    color: var(--sand-500, #8c8273);
  }

  .article-row__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .tag-pill {
    font-size: 0.6875rem;
    padding: 0.2rem 0.5rem;
    background: var(--sand-100, #f5f2eb);
    color: var(--ink-700, #4d483f);
    border-radius: 2px;
  }

  /* 6.8 Grid: Dua Kolom, Tanpa Kotak/Border/Shadow */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 3.5rem;
    row-gap: 4rem;
  }

  .grid-item__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .grid-item__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--sand-200, #ede7de);
    margin-bottom: 1.25rem;
  }

  .grid-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .grid-item:hover .grid-item__media img {
    transform: scale(1.02);
  }

  .grid-item__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small, 0.8125rem);
    color: var(--sand-600, #736b5e);
    margin-bottom: 0.5rem;
  }

  .grid-item__title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: var(--text-h3, 1.375rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-950, #12110d);
    margin: 0 0 0.5rem;
  }

  .grid-item:hover .grid-item__title {
    color: var(--ember-600, #b83d1b);
  }

  .grid-item__excerpt {
    font-size: var(--text-small, 0.875rem);
    color: var(--ink-700, #4d483f);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .article-row__link {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem 0;
    }

    .article-row__meta {
      align-items: flex-start;
      flex-direction: row;
      justify-content: space-between;
    }

    .articles-grid {
      grid-template-columns: 1fr;
      row-gap: 3rem;
    }
  }
</style>
