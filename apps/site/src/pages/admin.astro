---
// Panel Admin Jejak Rona (Clean Architecture Modular Components)
import "../admin/admin.css";

// Section Components
import AuthSection from "../components/admin/AuthSection.astro";
import DashboardSection from "../components/admin/DashboardSection.astro";
import PageEditorSection from "../components/admin/PageEditorSection.astro";
import MediaSection from "../components/admin/MediaSection.astro";
import ArticlesSection from "../components/admin/ArticlesSection.astro";
import MessagesSection from "../components/admin/MessagesSection.astro";
import SettingsSection from "../components/admin/SettingsSection.astro";

// Dialog Components
import DialogDeletePage from "../components/admin/DialogDeletePage.astro";
import DialogFocalPoint from "../components/admin/DialogFocalPoint.astro";
import DialogMediaPicker from "../components/admin/DialogMediaPicker.astro";
import DialogRevisions from "../components/admin/DialogRevisions.astro";
import DialogArticleEditor from "../components/admin/DialogArticleEditor.astro";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Admin | Jejak Rona</title>
  </head>
  <body>
    <div class="admin-shell">
      <!-- Navigasi Samping Sempit & Jelas (design.md Bagian 9) -->
      <aside class="admin-sidebar" aria-label="Navigasi admin">
        <div class="admin-brand">
          <span class="brand-badge">JR</span>
          <span class="brand-title">Jejak Rona</span>
        </div>

        <nav class="admin-nav" aria-label="Menu admin">
          <button
            class="admin-nav-item active"
            type="button"
            data-admin-view="dashboard">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="3" width="7" height="7"></rect><rect
                x="14"
                y="3"
                width="7"
                height="7"></rect><rect x="14" y="14" width="7" height="7"
              ></rect><rect x="3" y="14" width="7" height="7"></rect></svg
            >
            <span>Dashboard</span>
          </button>
          <button class="admin-nav-item" type="button" data-admin-view="pages">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path><polyline points="14 2 14 8 20 8"></polyline><line
                x1="16"
                y1="13"
                x2="8"
                y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
              ></line><polyline points="10 9 9 9 8 9"></polyline></svg
            >
            <span>Halaman</span>
          </button>
          <button
            class="admin-nav-item"
            type="button"
            data-admin-view="articles">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path
                d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
              ></path></svg
            >
            <span>Artikel</span>
          </button>
          <button
            class="admin-nav-item"
            type="button"
            data-admin-view="messages">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path><polyline points="22,6 12,13 2,6"></polyline></svg
            >
            <span>Pesan Masuk</span>
            <span
              id="messages-unread-badge"
              style="display:none; background:var(--ember-600); color:white; border-radius:10px; font-size:10px; padding:1px 5px; margin-left:auto;"
            ></span>
          </button>
          <button class="admin-nav-item" type="button" data-admin-view="media">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"
              ></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline
                points="21 15 16 10 5 21"></polyline></svg
            >
            <span>Media</span>
          </button>
          <button
            class="admin-nav-item"
            type="button"
            data-admin-view="settings">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><circle cx="12" cy="12" r="3"></circle><path
                d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
              ></path></svg
            >
            <span>Pengaturan</span>
          </button>
        </nav>

        <div class="sidebar-footer">
          <span>Jejak Rona v1.0</span>
        </div>
      </aside>

      <!-- Main Area -->
      <main class="admin-main">
        <!-- Topbar Padat -->
        <header class="admin-topbar">
          <div
            class="status-pill"
            id="status-banner"
            aria-live="polite"
            style="display: none;">
            <span class="status-dot" id="status-dot"></span>
            <span id="status-text"></span>
          </div>

          <div class="topbar-actions">
            <span class="user-badge" id="session-meta">Belum masuk</span>
            <button class="btn-logout hidden" id="logout-button" type="button"
              >Keluar</button
            >
          </div>
        </header>

        <div class="admin-content">
          <!-- 1. FORM LOGIN MODERN -->
          <AuthSection />

          <!-- 2. DASHBOARD PADAT & BERSIH (design.md: angka sederhana dengan label jelas, tanpa grafik hias) -->
          <DashboardSection />

          <!-- 3. TAHAP 6: EDITOR BLOK TIGA ZONA (Daftar Blok, Panel Bidang, Pratinjau Asli) -->
          <PageEditorSection />

          <!-- 4. PUSTAKA MEDIA -->
          <MediaSection />

          <!-- 5. ARTIKEL EDITORIAL -->
          <ArticlesSection />

          <!-- 6. PESAN MASUK FORMULIR KONTAK -->
          <MessagesSection />

          <!-- 7. PENGATURAN SITUS & NAVIGASI -->
          <SettingsSection />
        </div>
      </main>
    </div>

    <!-- DIALOGS & MODALS -->
    <DialogDeletePage />
    <DialogFocalPoint />
    <DialogMediaPicker />
    <DialogRevisions />
    <DialogArticleEditor />

    <script src="../admin/admin-auth.ts"></script>
  </body>
</html>
