<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Admin | Jejak Rona</title>
    <style>
      :root {
        --ink-950: #12110d;
        --ink-900: #1b1a16;
        --paper-0: #f8f4ef;
        --bone-50: #f3efe9;
        --bone-200: #d9d0c6;
        --ember-600: #c55a18;
        --grass-600: #2d6d4f;
        --danger-500: #b42318;
        --shadow-soft: 0 16px 38px rgba(18, 17, 13, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--paper-0);
        color: var(--ink-950);
        font-family: "Segoe UI", system-ui, sans-serif;
      }

      body {
        min-height: 100vh;
      }

      button,
      input {
        font: inherit;
      }

      .shell {
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        width: 260px;
        background: var(--ink-900);
        color: #f9f7f4;
        padding: 1.5rem 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 2rem;
      }

      .brand-mark {
        width: 2.2rem;
        height: 2.2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.7rem;
        background: rgba(197, 90, 24, 0.18);
        color: #ffb879;
        font-weight: 700;
      }

      .nav {
        display: grid;
        gap: 0.5rem;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        width: 100%;
        border: 0;
        border-radius: 0.75rem;
        padding: 0.8rem 0.9rem;
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: default;
      }

      .nav-item.active {
        background: rgba(255, 255, 255, 0.06);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
      }

      .main {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid rgba(18, 17, 13, 0.1);
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(8px);
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.55rem 0.8rem;
        border-radius: 999px;
        background: #f7efe8;
        border: 1px solid rgba(18, 17, 13, 0.08);
      }

      .status-dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 999px;
        background: var(--grass-600);
      }

      .status-warning {
        background: rgba(197, 90, 24, 0.12);
      }

      .status-dot.warning {
        background: var(--ember-600);
      }

      .status-dot.alert {
        background: var(--danger-500);
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .button {
        border: 1px solid rgba(18, 17, 13, 0.18);
        border-radius: 0.8rem;
        background: white;
        color: var(--ink-950);
        padding: 0.7rem 1rem;
        cursor: pointer;
      }

      .button.primary {
        background: var(--ember-600);
        border-color: var(--ember-600);
        color: white;
      }

      .button.secondary {
        background: transparent;
      }

      .panel {
        margin: 1.5rem auto;
        width: min(1200px, calc(100% - 2rem));
        display: grid;
        gap: 1.25rem;
      }

      .auth-card,
      .dashboard-card {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(18, 17, 13, 0.08);
        border-radius: 1.2rem;
        box-shadow: var(--shadow-soft);
      }

      .auth-card {
        max-width: 560px;
        margin: 2rem auto 0;
        padding: 2rem;
      }

      .auth-card h1,
      .dashboard-card h2 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.5rem, 2vw, 2rem);
      }

      .subtitle,
      .muted {
        color: rgba(18, 17, 13, 0.7);
      }

      .form-grid {
        display: grid;
        gap: 1rem;
        margin-top: 1.5rem;
      }

      label {
        display: grid;
        gap: 0.45rem;
        font-weight: 600;
      }

      input {
        border-radius: 0.9rem;
        border: 1px solid rgba(18, 17, 13, 0.18);
        background: white;
        padding: 0.82rem 0.95rem;
      }

      .inline-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.75rem;
      }

      .link-button {
        border: 0;
        background: transparent;
        color: var(--ember-600);
        font-weight: 700;
        cursor: pointer;
      }

      .message {
        min-height: 1.5rem;
        border-radius: 0.7rem;
        padding: 0.75rem 0.9rem;
        font-size: 0.95rem;
        display: none;
      }

      .message.visible {
        display: block;
      }

      .message.error {
        background: rgba(180, 35, 24, 0.08);
        color: var(--danger-500);
        border: 1px solid rgba(180, 35, 24, 0.18);
      }

      .message.success {
        background: rgba(45, 109, 79, 0.08);
        color: #214f3a;
        border: 1px solid rgba(45, 109, 79, 0.18);
      }

      .dashboard-card {
        padding: 1.5rem;
      }

      .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .metric {
        border: 1px solid rgba(18, 17, 13, 0.08);
        background: #f9f7f4;
        border-radius: 1rem;
        padding: 1rem;
      }

      .metric-label {
        color: rgba(18, 17, 13, 0.68);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .metric-value {
        display: block;
        font-size: 2rem;
        font-weight: 700;
        margin-top: 0.7rem;
      }

      .list {
        display: grid;
        gap: 0.85rem;
        margin-top: 1rem;
      }

      .list-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        border: 1px solid rgba(18, 17, 13, 0.08);
        border-radius: 0.9rem;
        padding: 0.9rem 1rem;
        background: #f7f3ef;
      }

      .role-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        background: rgba(197, 90, 24, 0.12);
        color: var(--ember-600);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .hidden {
        display: none !important;
      }

      .editor-panel {
        width: 100%;
        min-width: 0;
        border-top: 1px solid rgba(18, 17, 13, 0.12);
        padding-top: 1.5rem;
      }

      .editor-toolbar,
      .editor-actions,
      .page-row,
      .block-row,
      .preview-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .editor-toolbar {
        margin-bottom: 1rem;
      }

      .editor-toolbar h2 {
        margin: 0;
        font-size: 1.3rem;
      }

      .editor-message {
        margin: 0 0 1rem;
      }

      .editor-message.error,
      .validation-errors {
        color: var(--danger-500);
      }

      .editor-message.success {
        color: var(--grass-600);
      }

      .page-list-view {
        display: grid;
        gap: 1rem;
      }

      .page-search {
        max-width: 460px;
      }

      .page-list {
        display: grid;
        gap: 0.5rem;
      }

      .page-row {
        padding: 0.65rem;
        border-bottom: 1px solid rgba(18, 17, 13, 0.12);
      }

      .page-row__open {
        display: grid;
        gap: 0.25rem;
        flex: 1;
        min-width: 0;
        border: 0;
        padding: 0.4rem;
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: pointer;
      }

      .page-row__open span {
        color: rgba(18, 17, 13, 0.68);
        font-size: 0.88rem;
      }

      .compact {
        padding: 0.55rem 0.75rem;
      }

      .editor-workspace {
        display: grid;
        grid-template-columns: minmax(190px, 0.75fr) minmax(240px, 1fr) minmax(
            300px,
            1.35fr
          );
        min-height: 580px;
        border: 1px solid rgba(18, 17, 13, 0.12);
        background: #fff;
      }

      .editor-zone {
        min-width: 0;
        padding: 1rem;
        border-right: 1px solid rgba(18, 17, 13, 0.12);
      }

      .editor-zone:last-child {
        border-right: 0;
      }

      .editor-zone h3 {
        margin: 0 0 0.85rem;
        font-size: 0.95rem;
      }

      .editor-field-list {
        display: grid;
        align-content: start;
        gap: 0.8rem;
        max-height: 540px;
        overflow-y: auto;
      }

      .editor-field {
        display: grid;
        gap: 0.35rem;
        font-size: 0.85rem;
      }

      .editor-field input,
      .editor-field textarea,
      .editor-field select {
        width: 100%;
        min-width: 0;
        border: 1px solid rgba(18, 17, 13, 0.2);
        border-radius: 0.35rem;
        padding: 0.6rem;
        background: white;
      }

      .editor-field textarea {
        min-height: 92px;
        resize: vertical;
      }

      .block-list {
        display: grid;
        align-content: start;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .block-row {
        align-items: stretch;
        border: 1px solid rgba(18, 17, 13, 0.12);
        background: #faf8f5;
      }

      .block-row.selected {
        border-color: var(--ember-600);
      }

      .block-row__select {
        flex: 1;
        border: 0;
        padding: 0.65rem;
        background: transparent;
        color: inherit;
        text-align: left;
        text-transform: capitalize;
        cursor: pointer;
      }

      .block-row__actions {
        display: flex;
        align-items: center;
        gap: 0.15rem;
        padding-right: 0.25rem;
      }

      .icon-button {
        width: 36px;
        height: 36px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--ink-950);
        font-size: 1.1rem;
        cursor: pointer;
      }

      .icon-button:disabled,
      .nav-item:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      .add-block-row {
        display: flex;
        gap: 0.4rem;
      }

      .add-block-row select {
        flex: 1;
        min-width: 0;
      }

      .preview-toolbar {
        flex-wrap: wrap;
        margin-bottom: 0.7rem;
      }

      .preview-modes {
        display: flex;
        gap: 0.35rem;
      }

      .preview-modes button {
        min-height: 36px;
        border: 1px solid rgba(18, 17, 13, 0.2);
        background: white;
        cursor: pointer;
      }

      .preview-modes button[aria-pressed="true"] {
        border-color: var(--ember-600);
        box-shadow: inset 0 -2px var(--ember-600);
      }

      .preview-frame {
        display: flex;
        justify-content: center;
        min-height: 500px;
        padding: 0.5rem;
        overflow: auto;
        background: #e6e2dd;
      }

      .preview-frame iframe {
        width: 100%;
        min-height: 540px;
        border: 0;
        background: white;
      }

      .preview-frame iframe[data-size="tablet"] {
        width: min(768px, 100%);
      }

      .preview-frame iframe[data-size="mobile"] {
        width: min(390px, 100%);
      }

      .page-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem;
        margin-bottom: 1rem;
      }

      .page-meta-grid .editor-field {
        min-width: 0;
      }

      .delete-dialog {
        width: min(440px, calc(100% - 2rem));
        border: 1px solid rgba(18, 17, 13, 0.2);
        padding: 1.5rem;
        color: var(--ink-950);
      }

      .delete-dialog::backdrop {
        background: rgba(18, 17, 13, 0.55);
      }

      .delete-dialog h2 {
        margin-top: 0;
        font-size: 1.25rem;
      }

      [data-state="error"] {
        color: var(--danger-500);
      }

      [data-state="saved"] {
        color: var(--grass-600);
      }

      @media (max-width: 1100px) {
        .editor-workspace {
          grid-template-columns: minmax(190px, 0.8fr) minmax(240px, 1fr);
        }

        .preview-zone {
          grid-column: 1 / -1;
          border-top: 1px solid rgba(18, 17, 13, 0.12);
        }
      }

      @media (max-width: 820px) {
        .shell {
          flex-direction: column;
        }

        .sidebar {
          width: 100%;
        }

        .dashboard-grid {
          grid-template-columns: 1fr;
        }

        .inline-actions {
          flex-direction: column;
          align-items: flex-start;
        }

        .editor-workspace {
          grid-template-columns: 1fr;
        }

        .editor-zone {
          border-right: 0;
          border-bottom: 1px solid rgba(18, 17, 13, 0.12);
        }

        .editor-zone:last-child {
          border-bottom: 0;
        }

        .page-meta-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" aria-label="Navigasi admin">
        <div class="brand">
          <span class="brand-mark">JR</span>
          <span>Jejak Rona</span>
        </div>

        <nav class="nav" aria-label="Menu utama admin">
          <button
            class="nav-item active"
            type="button"
            data-admin-view="dashboard">Dashboard</button
          >
          <button class="nav-item" type="button" data-admin-view="pages"
            >Halaman</button
          >
          <button class="nav-item" type="button" disabled>Media</button>
          <button class="nav-item" type="button" disabled>Pengaturan</button>
        </nav>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="status" id="status-banner" aria-live="polite">
            <span class="status-dot" id="status-dot"></span>
            <span id="status-text">Memeriksa sesi admin…</span>
          </div>

          <div class="topbar-actions">
            <span class="muted" id="session-meta">Belum masuk</span>
            <button
              class="button secondary hidden"
              id="logout-button"
              type="button">Keluar</button
            >
          </div>
        </header>

        <div class="panel">
          <section class="auth-card hidden" id="auth-panel" aria-live="polite">
            <h1>Masuk ke panel admin</h1>
            <p class="subtitle">
              Gunakan akun Supabase terverifikasi untuk mengelola konten publik.
            </p>

            <div id="auth-message" class="message" aria-live="assertive"></div>

            <form id="login-form" class="form-grid" novalidate>
              <label>
                Email
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="admin@jejakrona.com"
                  required
                />
              </label>

              <label>
                Kata sandi
                <input
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  placeholder="Masukkan kata sandi"
                  required
                />
              </label>

              <div class="inline-actions">
                <button class="button primary" id="login-button" type="submit"
                  >Masuk</button
                >
                <button
                  class="button secondary"
                  id="reset-password"
                  type="button">Reset kata sandi</button
                >
              </div>
            </form>
          </section>

          <section
            class="dashboard-card hidden"
            id="dashboard"
            aria-live="polite">
            <h2>Dashboard</h2>
            <p class="muted" id="profile-overview">Memuat profil pengguna…</p>

            <div id="access-message" class="message" aria-live="assertive">
            </div>

            <div class="dashboard-grid">
              <article class="metric">
                <span class="metric-label">Halaman terbit</span>
                <span class="metric-value">12</span>
              </article>
              <article class="metric">
                <span class="metric-label">Draf aktif</span>
                <span class="metric-value">4</span>
              </article>
              <article class="metric">
                <span class="metric-label">Build status</span>
                <span class="metric-value">Siap</span>
              </article>
            </div>

            <div class="list">
              <div class="list-item">
                <span>Hak akses</span>
                <span class="role-pill" id="role-badge">Editor</span>
              </div>
              <div class="list-item">
                <span>URL situs publik</span>
                <span id="site-url">http://localhost:4321</span>
              </div>
              <div class="list-item">
                <span>Pemeriksaan RLS</span>
                <span>Database + Auth aktif</span>
              </div>
            </div>
          </section>

          <section
            class="editor-panel hidden"
            id="page-editor"
            aria-label="Editor halaman">
            <div class="editor-toolbar">
              <h2>Halaman</h2>
              <div class="editor-actions">
                <span
                  id="draft-save-status"
                  data-state="saved"
                  aria-live="polite">Memuat halaman…</span
                >
                <button class="button primary" id="create-page" type="button"
                  >Buat halaman</button
                >
              </div>
            </div>

            <p
              id="editor-message"
              class="message editor-message hidden"
              role="status">
            </p>

            <div id="page-list-view" class="page-list-view">
              <label class="editor-field page-search">
                <span>Cari halaman</span>
                <input
                  id="page-search"
                  type="search"
                  placeholder="Judul atau slug"
                />
              </label>
              <div id="page-list" class="page-list" aria-live="polite"></div>
            </div>

            <div id="page-edit-view" class="hidden">
              <div class="editor-toolbar">
                <button
                  class="button secondary"
                  id="back-to-pages"
                  type="button">Kembali ke daftar</button
                >
                <div class="editor-actions">
                  <button
                    class="button secondary"
                    id="undo-edit"
                    type="button"
                    title="Undo">Undo</button
                  >
                  <button
                    class="button secondary"
                    id="redo-edit"
                    type="button"
                    title="Redo">Redo</button
                  >
                  <button
                    class="button secondary"
                    id="delete-page"
                    type="button">Hapus</button
                  >
                </div>
              </div>

              <form id="page-form" class="page-meta-grid" autocomplete="off">
                <label class="editor-field"
                  ><span>Judul halaman</span><input
                    name="title"
                    maxlength="120"
                    required
                  /></label
                >
                <label class="editor-field"
                  ><span>Slug</span><input
                    name="slug"
                    maxlength="100"
                    pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                    required
                  /></label
                >
                <label class="editor-field"
                  ><span>Judul SEO</span><input
                    name="seo-title"
                    maxlength="70"
                    required
                  /></label
                >
                <label class="editor-field"
                  ><span>Deskripsi SEO</span><textarea
                    name="seo-description"
                    maxlength="160"></textarea></label
                >
                <label class="editor-field"
                  ><span
                    ><input name="is-home" type="checkbox" /> Jadikan beranda</span
                  ></label
                >
              </form>

              <div class="editor-workspace">
                <section class="editor-zone" aria-label="Urutan blok">
                  <h3>Blok halaman</h3>
                  <div id="block-list" class="block-list"></div>
                  <div class="add-block-row">
                    <select id="new-block-type" aria-label="Jenis blok baru">
                      <option value="hero_media">Hero media</option>
                      <option value="rich_text">Rich text</option>
                      <option value="image_full">Gambar penuh</option>
                    </select>
                    <button class="button compact" id="add-block" type="button"
                      >Tambah</button
                    >
                  </div>
                  <p class="muted">
                    Gunakan Alt + ↑ / ↓ untuk memindahkan blok terpilih.
                  </p>
                </section>

                <section class="editor-zone" aria-label="Bidang blok terpilih">
                  <h3>Bidang blok</h3>
                  <div id="block-fields" class="editor-field-list"></div>
                </section>

                <section
                  class="editor-zone preview-zone"
                  aria-label="Pratinjau draf">
                  <div class="preview-toolbar">
                    <h3>Pratinjau draf</h3>
                    <div
                      class="preview-modes"
                      role="group"
                      aria-label="Ukuran pratinjau">
                      <button
                        type="button"
                        data-preview-size="mobile"
                        aria-pressed="false">Ponsel</button
                      >
                      <button
                        type="button"
                        data-preview-size="tablet"
                        aria-pressed="false">Tablet</button
                      >
                      <button
                        type="button"
                        data-preview-size="desktop"
                        aria-pressed="true">Desktop</button
                      >
                    </div>
                  </div>
                  <div class="preview-frame">
                    <iframe
                      id="draft-preview"
                      title="Pratinjau halaman draf"
                      data-size="desktop"
                      sandbox="allow-same-origin"></iframe>
                  </div>
                </section>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <dialog
      class="delete-dialog"
      id="delete-page-dialog"
      aria-labelledby="delete-title">
      <h2 id="delete-title">Hapus halaman?</h2>
      <p>
        Tindakan ini tidak dapat dibatalkan. Ketik judul halaman untuk
        mengonfirmasi.
      </p>
      <label class="editor-field"
        ><span>Judul halaman</span><input
          id="delete-page-name"
          autocomplete="off"
        /></label
      >
      <div class="inline-actions">
        <button class="button secondary" id="cancel-delete" type="button"
          >Batal</button
        >
        <button
          class="button primary"
          id="delete-page-confirm"
          type="button"
          disabled>Hapus permanen</button
        >
      </div>
    </dialog>

    <script src="../admin/admin-auth.ts"></script>
  </body>
</html>
