<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Admin | Jejak Rona</title>
    <style>
      :root {
        --ink-950: #12110d;
        --ink-900: #1b1a16;
        --paper-0: #f8f4ef;
        --bone-50: #f3efe9;
        --bone-200: #d9d0c6;
        --ember-600: #c55a18;
        --grass-600: #2d6d4f;
        --danger-500: #b42318;
        --shadow-soft: 0 16px 38px rgba(18, 17, 13, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--paper-0);
        color: var(--ink-950);
        font-family: "Segoe UI", system-ui, sans-serif;
      }

      body {
        min-height: 100vh;
      }

      button,
      input {
        font: inherit;
      }

      .shell {
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        width: 260px;
        background: var(--ink-900);
        color: #f9f7f4;
        padding: 1.5rem 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 2rem;
      }

      .brand-mark {
        width: 2.2rem;
        height: 2.2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.7rem;
        background: rgba(197, 90, 24, 0.18);
        color: #ffb879;
        font-weight: 700;
      }

      .nav {
        display: grid;
        gap: 0.5rem;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        width: 100%;
        border: 0;
        border-radius: 0.75rem;
        padding: 0.8rem 0.9rem;
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: default;
      }

      .nav-item.active {
        background: rgba(255, 255, 255, 0.06);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
      }

      .main {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid rgba(18, 17, 13, 0.1);
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(8px);
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.55rem 0.8rem;
        border-radius: 999px;
        background: #f7efe8;
        border: 1px solid rgba(18, 17, 13, 0.08);
      }

      .status-dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 999px;
        background: var(--grass-600);
      }

      .status-warning {
        background: rgba(197, 90, 24, 0.12);
      }

      .status-dot.warning {
        background: var(--ember-600);
      }

      .status-dot.alert {
        background: var(--danger-500);
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .button {
        border: 1px solid rgba(18, 17, 13, 0.18);
        border-radius: 0.8rem;
        background: white;
        color: var(--ink-950);
        padding: 0.7rem 1rem;
        cursor: pointer;
      }

      .button.primary {
        background: var(--ember-600);
        border-color: var(--ember-600);
        color: white;
      }

      .button.secondary {
        background: transparent;
      }

      .panel {
        margin: 1.5rem auto;
        width: min(1200px, calc(100% - 2rem));
        display: grid;
        gap: 1.25rem;
      }

      .auth-card,
      .dashboard-card {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(18, 17, 13, 0.08);
        border-radius: 1.2rem;
        box-shadow: var(--shadow-soft);
      }

      .auth-card {
        max-width: 560px;
        margin: 2rem auto 0;
        padding: 2rem;
      }

      .auth-card h1,
      .dashboard-card h2 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.5rem, 2vw, 2rem);
      }

      .subtitle,
      .muted {
        color: rgba(18, 17, 13, 0.7);
      }

      .form-grid {
        display: grid;
        gap: 1rem;
        margin-top: 1.5rem;
      }

      label {
        display: grid;
        gap: 0.45rem;
        font-weight: 600;
      }

      input {
        border-radius: 0.9rem;
        border: 1px solid rgba(18, 17, 13, 0.18);
        background: white;
        padding: 0.82rem 0.95rem;
      }

      .inline-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.75rem;
      }

      .link-button {
        border: 0;
        background: transparent;
        color: var(--ember-600);
        font-weight: 700;
        cursor: pointer;
      }

      .message {
        min-height: 1.5rem;
        border-radius: 0.7rem;
        padding: 0.75rem 0.9rem;
        font-size: 0.95rem;
        display: none;
      }

      .message.visible {
        display: block;
      }

      .message.error {
        background: rgba(180, 35, 24, 0.08);
        color: var(--danger-500);
        border: 1px solid rgba(180, 35, 24, 0.18);
      }

      .message.success {
        background: rgba(45, 109, 79, 0.08);
        color: #214f3a;
        border: 1px solid rgba(45, 109, 79, 0.18);
      }

      .dashboard-card {
        padding: 1.5rem;
      }

      .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .metric {
        border: 1px solid rgba(18, 17, 13, 0.08);
        background: #f9f7f4;
        border-radius: 1rem;
        padding: 1rem;
      }

      .metric-label {
        color: rgba(18, 17, 13, 0.68);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .metric-value {
        display: block;
        font-size: 2rem;
        font-weight: 700;
        margin-top: 0.7rem;
      }

      .list {
        display: grid;
        gap: 0.85rem;
        margin-top: 1rem;
      }

      .list-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        border: 1px solid rgba(18, 17, 13, 0.08);
        border-radius: 0.9rem;
        padding: 0.9rem 1rem;
        background: #f7f3ef;
      }

      .role-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        background: rgba(197, 90, 24, 0.12);
        color: var(--ember-600);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .hidden {
        display: none !important;
      }

      @media (max-width: 820px) {
        .shell {
          flex-direction: column;
        }

        .sidebar {
          width: 100%;
        }

        .dashboard-grid {
          grid-template-columns: 1fr;
        }

        .inline-actions {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" aria-label="Navigasi admin">
        <div class="brand">
          <span class="brand-mark">JR</span>
          <span>Jejak Rona</span>
        </div>

        <nav class="nav" aria-label="Menu utama admin">
          <button class="nav-item active" type="button">Dashboard</button>
          <button class="nav-item" type="button">Halaman</button>
          <button class="nav-item" type="button">Media</button>
          <button class="nav-item" type="button">Pengaturan</button>
        </nav>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="status" id="status-banner" aria-live="polite">
            <span class="status-dot" id="status-dot"></span>
            <span id="status-text">Memeriksa sesi admin…</span>
          </div>

          <div class="topbar-actions">
            <span class="muted" id="session-meta">Belum masuk</span>
            <button
              class="button secondary hidden"
              id="logout-button"
              type="button">Keluar</button
            >
          </div>
        </header>

        <div class="panel">
          <section class="auth-card hidden" id="auth-panel" aria-live="polite">
            <h1>Masuk ke panel admin</h1>
            <p class="subtitle">
              Gunakan akun Supabase terverifikasi untuk mengelola konten publik.
            </p>

            <div id="auth-message" class="message" aria-live="assertive"></div>

            <form id="login-form" class="form-grid" novalidate>
              <label>
                Email
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="admin@jejakrona.com"
                  required
                />
              </label>

              <label>
                Kata sandi
                <input
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  placeholder="Masukkan kata sandi"
                  required
                />
              </label>

              <div class="inline-actions">
                <button class="button primary" id="login-button" type="submit"
                  >Masuk</button
                >
                <button
                  class="button secondary"
                  id="reset-password"
                  type="button">Reset kata sandi</button
                >
              </div>
            </form>
          </section>

          <section
            class="dashboard-card hidden"
            id="dashboard"
            aria-live="polite">
            <h2>Dashboard</h2>
            <p class="muted" id="profile-overview">Memuat profil pengguna…</p>

            <div id="access-message" class="message" aria-live="assertive">
            </div>

            <div class="dashboard-grid">
              <article class="metric">
                <span class="metric-label">Halaman terbit</span>
                <span class="metric-value">12</span>
              </article>
              <article class="metric">
                <span class="metric-label">Draf aktif</span>
                <span class="metric-value">4</span>
              </article>
              <article class="metric">
                <span class="metric-label">Build status</span>
                <span class="metric-value">Siap</span>
              </article>
            </div>

            <div class="list">
              <div class="list-item">
                <span>Hak akses</span>
                <span class="role-pill" id="role-badge">Editor</span>
              </div>
              <div class="list-item">
                <span>URL situs publik</span>
                <span id="site-url">http://localhost:4321</span>
              </div>
              <div class="list-item">
                <span>Pemeriksaan RLS</span>
                <span>Database + Auth aktif</span>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <script type="module">
      import { createClient } from "@supabase/supabase-js";

      const supabaseUrl =
        import.meta.env.PUBLIC_SUPABASE_URL ||
        import.meta.env.SUPABASE_URL ||
        "";
      const supabaseAnonKey =
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
        import.meta.env.SUPABASE_ANON_KEY ||
        "";

      const statusText = document.getElementById("status-text");
      const statusDot = document.getElementById("status-dot");
      const statusBanner = document.getElementById("status-banner");
      const authPanel = document.getElementById("auth-panel");
      const dashboard = document.getElementById("dashboard");
      const sessionMeta = document.getElementById("session-meta");
      const logoutButton = document.getElementById("logout-button");
      const loginForm = document.getElementById("login-form");
      const emailInput = document.getElementById("email");
      const passwordInput = document.getElementById("password");
      const authMessage = document.getElementById("auth-message");
      const accessMessage = document.getElementById("access-message");
      const profileOverview = document.getElementById("profile-overview");
      const roleBadge = document.getElementById("role-badge");
      const siteUrl = document.getElementById("site-url");

      const envConfigured = Boolean(
        supabaseUrl &&
        supabaseAnonKey &&
        !supabaseUrl.includes("your-project") &&
        !supabaseAnonKey.includes("your-anon-key"),
      );

      const showMessage = (element, text, kind = "error") => {
        element.textContent = text;
        element.classList.remove("success", "error");
        element.classList.add(kind);
        element.classList.add("visible");
      };

      const clearMessage = (element) => {
        element.textContent = "";
        element.classList.remove("visible", "success", "error");
      };

      const setStatus = (label, tone = "ok") => {
        statusText.textContent = label;
        statusBanner.classList.toggle("status-warning", tone === "warn");
        statusDot.classList.remove("warning", "alert");
        if (tone === "warn") {
          statusDot.classList.add("warning");
        }
        if (tone === "error") {
          statusDot.classList.add("alert");
        }
      };

      const renderLoggedOut = () => {
        authPanel.classList.remove("hidden");
        dashboard.classList.add("hidden");
        logoutButton.classList.add("hidden");
        sessionMeta.textContent = "Belum masuk";
        profileOverview.textContent = "Masuk untuk mengakses dashboard admin.";
        clearMessage(accessMessage);
      };

      const renderUnauthorized = (message) => {
        authPanel.classList.remove("hidden");
        dashboard.classList.add("hidden");
        logoutButton.classList.remove("hidden");
        sessionMeta.textContent = "Sesi aktif";
        showMessage(authMessage, message, "error");
        setStatus("Akses ditolak — role tidak valid", "warn");
      };

      const renderDashboard = (user, profile) => {
        const role = profile?.role || "editor";
        authPanel.classList.add("hidden");
        dashboard.classList.remove("hidden");
        logoutButton.classList.remove("hidden");
        sessionMeta.textContent = user.email || "Admin terautentikasi";
        profileOverview.textContent = `Selamat datang, ${profile?.name || user.email || "admin"}.`;
        roleBadge.textContent = role;
        clearMessage(authMessage);
        setStatus("Admin siap", "ok");
      };

      if (!envConfigured) {
        setStatus("Konfigurasi Supabase belum siap", "warn");
        renderLoggedOut();
        showMessage(
          authMessage,
          "Isi PUBLIC_SUPABASE_URL dan PUBLIC_SUPABASE_ANON_KEY di lingkungan lokal untuk mengaktifkan login.",
          "error",
        );
      }

      const supabase = createClient(supabaseUrl, supabaseAnonKey, {
        auth: {
          persistSession: true,
          autoRefreshToken: true,
          detectSessionInUrl: true,
        },
      });

      const ensureRole = async (session) => {
        if (!session?.user) {
          renderLoggedOut();
          return;
        }

        const { data, error } = await supabase
          .from("profiles")
          .select("role, name")
          .eq("id", session.user.id)
          .maybeSingle();

        if (error) {
          renderUnauthorized(
            "Gagal memeriksa role di tabel profiles. Periksa RLS dan migrasi database.",
          );
          return;
        }

        const role = data?.role || null;
        if (!role || !["admin", "editor"].includes(role)) {
          renderUnauthorized(
            "Akses ditolak: pengguna belum terdaftar sebagai admin/editor di tabel profiles.",
          );
          return;
        }

        renderDashboard(session.user, data || { role, name: "Staff" });
      };

      const handleLogin = async (event) => {
        event.preventDefault();
        const email = emailInput.value.trim();
        const password = passwordInput.value.trim();

        if (!envConfigured) {
          showMessage(
            authMessage,
            "Tentukan konfigurasi Supabase terlebih dahulu.",
            "error",
          );
          return;
        }

        if (!email || !password) {
          showMessage(
            authMessage,
            "Email dan kata sandi wajib diisi.",
            "error",
          );
          return;
        }

        setStatus("Memproses login…", "warn");
        clearMessage(authMessage);

        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password,
        });

        if (error) {
          setStatus("Login gagal", "error");
          showMessage(
            authMessage,
            error.message || "Login gagal. Cek kredensial Anda.",
            "error",
          );
          return;
        }

        await ensureRole(data.session);
      };

      const handleReset = async () => {
        const email = emailInput.value.trim();

        if (!email) {
          showMessage(
            authMessage,
            "Masukkan email untuk mengirim tautan reset kata sandi.",
            "error",
          );
          return;
        }

        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: window.location.origin + "/admin",
        });

        if (error) {
          showMessage(authMessage, error.message, "error");
          return;
        }

        setStatus("Tautan reset dikirim", "ok");
        showMessage(
          authMessage,
          "Tautan reset kata sandi telah dikirim ke email Anda.",
          "success",
        );
      };

      const handleLogout = async () => {
        const { error } = await supabase.auth.signOut();
        if (error) {
          showMessage(authMessage, error.message, "error");
          return;
        }

        renderLoggedOut();
        setStatus("Sesi admin selesai", "ok");
      };

      loginForm.addEventListener("submit", handleLogin);
      document
        .getElementById("reset-password")
        .addEventListener("click", handleReset);
      logoutButton.addEventListener("click", handleLogout);

      siteUrl.textContent = window.location.origin;

      supabase.auth.onAuthStateChange(async (_event, session) => {
        if (_event === "SIGNED_OUT") {
          renderLoggedOut();
          setStatus("Belum masuk", "ok");
          return;
        }

        if (session) {
          await ensureRole(session);
        }
      });

      const {
        data: { session },
      } = await supabase.auth.getSession();
      await ensureRole(session);
    </script>
  </body>
</html>
