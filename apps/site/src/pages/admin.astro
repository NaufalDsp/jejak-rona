---
// Panel Admin Jejak Rona (Tahap 7: Media & Focal Point + Desain Padat)
import "../admin/admin.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Admin | Jejak Rona</title>
  </head>
  <body>
    <div class="admin-shell">
      <!-- Navigasi Samping Sempit & Jelas (design.md Bagian 9) -->
      <aside class="admin-sidebar" aria-label="Navigasi admin">
        <div class="admin-brand">
          <span class="brand-badge">JR</span>
          <span class="brand-title">Jejak Rona</span>
        </div>

        <nav class="admin-nav" aria-label="Menu admin">
          <button
            class="admin-nav-item active"
            type="button"
            data-admin-view="dashboard">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="3" width="7" height="7"></rect><rect
                x="14"
                y="3"
                width="7"
                height="7"></rect><rect x="14" y="14" width="7" height="7"
              ></rect><rect x="3" y="14" width="7" height="7"></rect></svg
            >
            <span>Dashboard</span>
          </button>
          <button class="admin-nav-item" type="button" data-admin-view="pages">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path><polyline points="14 2 14 8 20 8"></polyline><line
                x1="16"
                y1="13"
                x2="8"
                y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
              ></line><polyline points="10 9 9 9 8 9"></polyline></svg
            >
            <span>Halaman</span>
          </button>
          <button class="admin-nav-item" type="button" data-admin-view="media">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"
              ></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline
                points="21 15 16 10 5 21"></polyline></svg
            >
            <span>Media</span>
          </button>
          <button
            class="admin-nav-item"
            type="button"
            data-admin-view="settings"
            disabled
            title="Tersedia di Tahap 8">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><circle cx="12" cy="12" r="3"></circle><path
                d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
              ></path></svg
            >
            <span>Pengaturan</span>
          </button>
        </nav>

        <div class="sidebar-footer">
          <span>Jejak Rona v1.0</span>
        </div>
      </aside>

      <!-- Main Area -->
      <main class="admin-main">
        <!-- Topbar Padat (design.md: status build satu baris titik + teks) -->
        <header class="admin-topbar">
          <div class="status-pill" id="status-banner" aria-live="polite">
            <span class="status-dot" id="status-dot"></span>
            <span id="status-text">Memeriksa sesi…</span>
          </div>

          <div class="topbar-actions">
            <span class="user-badge" id="session-meta">Belum masuk</span>
            <button class="btn-text hidden" id="logout-button" type="button"
              >Keluar</button
            >
          </div>
        </header>

        <div class="admin-content">
          <!-- 1. FORM LOGIN MODERN -->
          <section
            class="auth-container hidden"
            id="auth-panel"
            aria-live="polite">
            <div class="auth-box">
              <h1>Masuk Panel Admin</h1>
              <p>
                Gunakan akun staf terverifikasi untuk mengelola konten dan
                media.
              </p>

              <div
                id="auth-message"
                class="admin-error-box hidden"
                aria-live="assertive">
              </div>

              <form id="login-form" novalidate>
                <div class="form-group">
                  <label for="email">Alamat Email</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    placeholder="admin@jejakrona.com"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="password">Kata Sandi</label>
                  <input
                    id="password"
                    name="password"
                    type="password"
                    autocomplete="current-password"
                    placeholder="••••••••"
                    required
                  />
                </div>

                <div
                  style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem;">
                  <button class="btn-primary" id="login-button" type="submit"
                    >Masuk ke Panel</button
                  >
                  <button class="btn-text" id="reset-password" type="button"
                    >Reset sandi</button
                  >
                </div>
              </form>
            </div>
          </section>

          <!-- 2. DASHBOARD PADAT & BERSIH (design.md: angka sederhana dengan label jelas, tanpa grafik hias) -->
          <section class="hidden" id="dashboard" aria-live="polite">
            <div class="admin-card">
              <div class="admin-card__header">
                <div>
                  <h2 class="admin-card__title" id="profile-overview">
                    Dashboard
                  </h2>
                  <span class="muted" style="font-size: 12px;"
                    >Ringkasan status publikasi situs dan berkas editorial.</span
                  >
                </div>
                <div>
                  <span class="badge badge-published" id="role-badge"
                    >ADMIN</span
                  >
                </div>
              </div>

              <!-- Baris Metrik Berdaya Guna -->
              <div class="metrics-row">
                <div class="metric-cell">
                  <div class="metric-cell__label">Halaman Terbit</div>
                  <div class="metric-cell__value" id="stat-published-count">
                    2
                  </div>
                  <div class="metric-cell__sub">Dapat dibaca publik</div>
                </div>
                <div class="metric-cell">
                  <div class="metric-cell__label">Draf Aktif</div>
                  <div class="metric-cell__value" id="stat-draft-count">1</div>
                  <div class="metric-cell__sub">Belum dipublikasikan</div>
                </div>
                <div class="metric-cell">
                  <div class="metric-cell__label">Berkas Media</div>
                  <div class="metric-cell__value" id="stat-media-count">3</div>
                  <div class="metric-cell__sub">Foto & Video terdaftar</div>
                </div>
                <div class="metric-cell">
                  <div class="metric-cell__label">Status Build Situs</div>
                  <div
                    class="metric-cell__value"
                    style="font-size: 20px; color: var(--grass-600);">
                    TAYANG
                  </div>
                  <div class="metric-cell__sub">Astro Static Build</div>
                </div>
              </div>

              <!-- Aksi Cepat Tindakan Langsung -->
              <div class="quick-actions-bar">
                <button
                  class="btn-primary"
                  type="button"
                  id="dash-create-page-btn">+ Buat Halaman Baru</button
                >
                <button
                  class="btn-secondary"
                  type="button"
                  id="dash-open-media-btn">📁 Pustaka Media</button
                >
                <a
                  href="/"
                  target="_blank"
                  class="btn-secondary"
                  style="text-decoration: none;">Pratinjau Situs Publik ↗</a
                >
              </div>
            </div>

            <!-- Ringkasan Halaman Terdaftar -->
            <div class="admin-card">
              <div class="admin-card__header">
                <h3 class="admin-card__title">Daftar Halaman Situs</h3>
                <span class="muted" style="font-size: 12px;"
                  >Klik halaman untuk menyunting di Editor Blok.</span
                >
              </div>
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Judul Halaman</th>
                    <th>Slug URL</th>
                    <th>Peran</th>
                    <th>Status</th>
                    <th style="text-align: right;">Tindakan</th>
                  </tr>
                </thead>
                <tbody id="dash-pages-table">
                  <tr>
                    <td
                      colspan="5"
                      class="muted"
                      style="text-align: center; padding: 1.5rem;"
                      >Memuat daftar halaman…</td
                    >
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- 3. TAHAP 6: EDITOR BLOK TIGA ZONA (Daftar Blok, Panel Bidang, Pratinjau Asli) -->
          <section class="hidden" id="page-editor" aria-label="Editor halaman">
            <div
              class="admin-card"
              style="padding: 1rem 1.25rem; margin-bottom: 1rem;">
              <div
                style="display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                  <button class="btn-secondary" id="back-to-pages" type="button"
                    >← Kembali ke Daftar</button
                  >
                  <span
                    id="draft-save-status"
                    class="badge badge-published"
                    aria-live="polite">Tersimpan</span
                  >
                </div>
                <div style="display: flex; gap: 0.5rem;">
                  <button
                    class="btn-secondary"
                    id="undo-edit"
                    type="button"
                    title="Urungkan (Undo)">Undo</button
                  >
                  <button
                    class="btn-secondary"
                    id="redo-edit"
                    type="button"
                    title="Ulangi (Redo)">Redo</button
                  >
                  <button class="btn-text-danger" id="delete-page" type="button"
                    >Hapus Halaman</button
                  >
                </div>
              </div>
            </div>

            <p id="editor-message" class="admin-error-box hidden" role="status">
            </p>

            <!-- Tampilan List Halaman -->
            <div id="page-list-view" class="admin-card">
              <div class="media-toolbar">
                <input
                  id="page-search"
                  type="search"
                  placeholder="Cari halaman berdasarkan judul atau slug…"
                  style="padding: 0.45rem 0.75rem; border: 1px solid var(--bone-300); border-radius: 2px; width: 320px;"
                />
                <button class="btn-primary" id="create-page" type="button"
                  >+ Buat Halaman</button
                >
              </div>
              <div
                id="page-list"
                style="display: flex; flex-direction: column; gap: 4px;">
              </div>
            </div>

            <!-- Tampilan Workspace Editor 3 Zona -->
            <div id="page-edit-view" class="hidden">
              <form
                id="page-form"
                class="admin-card"
                style="margin-bottom: 1rem;"
                autocomplete="off">
                <div
                  style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: 0.75rem; align-items: end;">
                  <div>
                    <label
                      style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--stone-500); margin-bottom: 3px;"
                      >Judul Halaman</label
                    >
                    <input
                      name="title"
                      maxlength="120"
                      required
                      style="width: 100%; padding: 0.4rem 0.6rem; border: 1px solid var(--bone-300); border-radius: 2px;"
                    />
                  </div>
                  <div>
                    <label
                      style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--stone-500); margin-bottom: 3px;"
                      >Slug URL</label
                    >
                    <input
                      name="slug"
                      maxlength="100"
                      pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                      required
                      style="width: 100%; padding: 0.4rem 0.6rem; border: 1px solid var(--bone-300); border-radius: 2px;"
                    />
                  </div>
                  <div>
                    <label
                      style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--stone-500); margin-bottom: 3px;"
                      >Judul SEO</label
                    >
                    <input
                      name="seo-title"
                      maxlength="70"
                      required
                      style="width: 100%; padding: 0.4rem 0.6rem; border: 1px solid var(--bone-300); border-radius: 2px;"
                    />
                  </div>
                  <div>
                    <label
                      style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--stone-500); margin-bottom: 3px;"
                      >Deskripsi SEO</label
                    >
                    <input
                      name="seo-description"
                      maxlength="160"
                      style="width: 100%; padding: 0.4rem 0.6rem; border: 1px solid var(--bone-300); border-radius: 2px;"
                    />
                  </div>
                  <div style="padding-bottom: 6px;">
                    <label
                      style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 12px; cursor: pointer;">
                      <input name="is-home" type="checkbox" /> Halaman Beranda
                    </label>
                  </div>
                </div>
              </form>

              <!-- Workspace 3 Zona Sesuai design.md: Kiri (Daftar Blok), Tengah (Pratinjau Asli), Kanan (Panel Bidang) -->
              <div
                style="display: grid; grid-template-columns: 240px 1fr 340px; gap: 1rem; min-height: 640px;">
                <!-- Zona 1: Daftar Blok (Kiri) -->
                <div
                  class="admin-card"
                  style="padding: 1rem; display: flex; flex-direction: column;">
                  <h4
                    style="margin: 0 0 0.75rem; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--stone-500);">
                    Struktur Blok
                  </h4>
                  <div
                    id="block-list"
                    style="display: flex; flex-direction: column; gap: 4px; flex: 1; overflow-y: auto;">
                  </div>
                  <div
                    style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--bone-100); display: flex; gap: 4px;">
                    <select
                      id="new-block-type"
                      style="flex: 1; padding: 0.35rem; font-size: 13px; border: 1px solid var(--bone-300); border-radius: 2px;">
                      <option value="hero_media">Hero Media</option>
                      <option value="rich_text">Rich Text</option>
                      <option value="image_full">Gambar Penuh</option>
                    </select>
                    <button class="btn-primary-sm" id="add-block" type="button"
                      >+ Tambah</button
                    >
                  </div>
                  <small class="muted" style="margin-top: 6px; font-size: 13px;"
                    >Papan ketik: Alt + ↑ / ↓ untuk urutan.</small
                  >
                </div>

                <!-- Zona 2: Pratinjau Draf Asli (Tengah - design.md: memakai komponen asli) -->
                <div
                  class="admin-card"
                  style="padding: 1rem; display: flex; flex-direction: column;">
                  <div
                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <h4
                      style="margin: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--stone-500);">
                      Pratinjau Draf Asli
                    </h4>
                    <div
                      style="display: flex; gap: 2px; background: var(--bone-100); padding: 2px; border-radius: 2px;">
                      <button
                        type="button"
                        class="btn-text"
                        data-preview-size="desktop"
                        style="font-size: 13px; padding: 2px 6px;"
                        >Desktop</button
                      >
                      <button
                        type="button"
                        class="btn-text"
                        data-preview-size="tablet"
                        style="font-size: 13px; padding: 2px 6px;"
                        >Tablet</button
                      >
                      <button
                        type="button"
                        class="btn-text"
                        data-preview-size="mobile"
                        style="font-size: 13px; padding: 2px 6px;"
                        >Seluler</button
                      >
                    </div>
                  </div>
                  <div
                    style="flex: 1; background: var(--bone-200); display: flex; justify-content: center; overflow: auto; border: 1px solid var(--bone-300);">
                    <iframe
                      id="draft-preview"
                      title="Pratinjau draf"
                      data-size="desktop"
                      sandbox="allow-same-origin"
                      style="width: 100%; height: 100%; min-height: 540px; border: 0; background: #fff;"
                    ></iframe>
                  </div>
                </div>

                <!-- Zona 3: Panel Bidang Blok Terpilih (Kanan) -->
                <div
                  class="admin-card"
                  style="padding: 1rem; overflow-y: auto;">
                  <h4
                    style="margin: 0 0 0.75rem; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--stone-500);">
                    Bidang Blok Terpilih
                  </h4>
                  <div
                    id="block-fields"
                    style="display: flex; flex-direction: column; gap: 0.85rem;">
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- 4. TAHAP 7: PUSTAKA MEDIA (Media Library & Focal Point Picker) -->
          <section class="hidden" id="media-panel" aria-label="Pustaka media">
            <div class="admin-card">
              <div class="admin-card__header">
                <div>
                  <h2 class="admin-card__title">Pustaka Media</h2>
                  <span class="muted" style="font-size: 12px;"
                    >Unggah foto editorial dan video loop hero berizin resmi.</span
                  >
                </div>
                <div style="display: flex; gap: 0.5rem;">
                  <input
                    type="file"
                    id="media-file-input"
                    accept="image/webp,image/jpeg,image/png,video/mp4,video/webm"
                    class="hidden"
                  />
                  <button
                    class="btn-primary"
                    type="button"
                    id="upload-media-trigger">+ Unggah Berkas</button
                  >
                </div>
              </div>

              <!-- Filter & Search Toolbar -->
              <div class="media-toolbar">
                <input
                  id="media-search"
                  type="search"
                  placeholder="Cari nama berkas atau teks alt…"
                  style="padding: 0.45rem 0.75rem; border: 1px solid var(--bone-300); border-radius: 2px; width: 280px;"
                />
                <div class="media-filters">
                  <button
                    class="media-tab active"
                    type="button"
                    data-media-filter="all">Semua</button
                  >
                  <button
                    class="media-tab"
                    type="button"
                    data-media-filter="image">Foto</button
                  >
                  <button
                    class="media-tab"
                    type="button"
                    data-media-filter="video">Video</button
                  >
                </div>
              </div>

              <!-- Drag & Drop Area -->
              <div class="media-dropzone" id="media-dropzone">
                <p>
                  Seret berkas foto atau video ke sini, atau klik tombol Unggah
                  di atas.
                </p>
                <small class="muted"
                  >Format: WebP, JPEG, PNG, MP4. Video loop maks 6 MB & 15-20
                  detik.</small
                >
              </div>

              <div
                id="media-upload-error"
                class="admin-error-box hidden"
                style="white-space: pre-wrap;">
              </div>
              <div id="media-upload-progress" class="admin-loading hidden">
              </div>

              <!-- Gallery Grid -->
              <div class="media-grid" id="media-grid"></div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <!-- DIALOG KONFIRMASI HAPUS HALAMAN (design.md: konfirmasi ketik nama) -->
    <dialog
      class="admin-card"
      id="delete-page-dialog"
      style="width: min(400px, 90vw); border: 1px solid var(--bone-300); padding: 1.5rem;">
      <h3 style="margin-top: 0;">Hapus Halaman?</h3>
      <p style="font-size: 13px; color: var(--stone-700);">
        Tindakan ini permanen. Ketik persis judul halaman untuk mengonfirmasi:
      </p>
      <input
        id="delete-page-name"
        autocomplete="off"
        style="width: 100%; padding: 0.5rem; border: 1px solid var(--bone-300); margin-bottom: 1rem;"
      />
      <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
        <button class="btn-secondary" id="cancel-delete" type="button"
          >Batal</button
        >
        <button
          class="btn-primary"
          id="delete-page-confirm"
          type="button"
          disabled
          style="background: var(--danger-500); border-color: var(--danger-500);"
          >Hapus Permanen</button
        >
      </div>
    </dialog>

    <!-- DIALOG PEMILIH TITIK FOKUS INTERAKTIF (design.md: gambar dengan penanda lingkaran yang bisa diseret, 2 pratinjau live) -->
    <dialog class="focal-dialog" id="focal-point-dialog">
      <div
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bone-200); padding-bottom: 0.75rem;">
        <h3 style="margin: 0; font-size: 15px; font-weight: 600;">
          Atur Titik Fokus (Focal Point) & Aksesibilitas
        </h3>
        <span class="badge badge-published" id="focal-coords-display"
          >X: 50% | Y: 50%</span
        >
      </div>

      <div class="focal-layout">
        <!-- Area Kanvas Gambar Interaktif -->
        <div>
          <label
            style="display: block; font-size: 11px; text-transform: uppercase; font-weight: 600; color: var(--stone-500); margin-bottom: 4px;"
            >Klik atau geser target lingkaran ke subjek utama foto:</label
          >
          <div class="focal-canvas-wrap" id="focal-interactive-canvas">
            <img id="focal-source-image" src="" alt="Focal target" />
            <div
              class="focal-target-marker"
              id="focal-marker"
              style="left: 50%; top: 50%;">
            </div>
          </div>
          <small
            class="muted"
            style="display: block; margin-top: 4px; font-size: 11px;"
            >Titik ini menentukan pusat pemotongan foto saat layar menyempit
            (desktop vs ponsel).</small
          >

          <!-- Input Metadata Alt & Kredit Wajib -->
          <div
            style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
            <div>
              <label
                style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--stone-500); margin-bottom: 3px;"
                >Teks Alt (Wajib untuk aksesibilitas pembaca layar)</label
              >
              <input
                id="focal-alt-input"
                style="width: 100%; padding: 0.45rem 0.6rem; border: 1px solid var(--bone-300); border-radius: 2px;"
                placeholder="Deskripsikan isi foto secara jujur…"
              />
            </div>
            <div>
              <label
                style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--stone-500); margin-bottom: 3px;"
                >Kredit Foto & Lisensi</label
              >
              <input
                id="focal-credit-input"
                style="width: 100%; padding: 0.45rem 0.6rem; border: 1px solid var(--bone-300); border-radius: 2px;"
                placeholder="Contoh: Nama Fotografer / Unsplash"
              />
            </div>
          </div>
        </div>

        <!-- Dua Pratinjau Langsung (Desktop 16:9 & Seluler 9:16) -->
        <div class="focal-previews">
          <div class="preview-box">
            <div class="preview-box__label">
              Pratinjau Pemotongan Desktop (16:9)
            </div>
            <div class="preview-desktop-crop">
              <img id="focal-prev-desktop" src="" alt="Desktop Crop" />
            </div>
          </div>
          <div class="preview-box">
            <div class="preview-box__label">
              Pratinjau Pemotongan Seluler (9:16)
            </div>
            <div class="preview-mobile-crop">
              <img id="focal-prev-mobile" src="" alt="Mobile Crop" />
            </div>
          </div>
        </div>
      </div>

      <div
        style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1.25rem; border-top: 1px solid var(--bone-200); padding-top: 1rem;">
        <button class="btn-secondary" id="close-focal-dialog" type="button"
          >Tutup</button
        >
        <button class="btn-primary" id="save-focal-point" type="button"
          >Simpan Titik Fokus</button
        >
      </div>
    </dialog>

    <!-- DIALOG PEMILIH MEDIA UNTUK EDITOR BLOK -->
    <dialog class="picker-dialog" id="media-picker-modal">
      <div
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bone-200); padding-bottom: 0.75rem; margin-bottom: 1rem;">
        <h3 style="margin: 0; font-size: 15px; font-weight: 600;">
          Pilih Berkas dari Pustaka Media
        </h3>
        <button
          class="btn-text"
          onclick="document.getElementById('media-picker-modal').close()"
          type="button">Batal</button
        >
      </div>
      <div
        class="media-grid"
        id="picker-media-grid"
        style="max-height: 55vh; overflow-y: auto;">
      </div>
    </dialog>

    <script src="../admin/admin-auth.ts"></script>
  </body>
</html>
