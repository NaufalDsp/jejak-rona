---
import SiteLayout from "../layouts/SiteLayout.astro";
import BlockRenderer from "../blocks/BlockRenderer.astro";
import { GetPublishedPageUseCase } from "../application/use-cases/get-published-page.use-case.js";
import { SupabasePageRepository } from "../infrastructure/supabase/supabase-page.repository.js";

export async function getStaticPaths() {
  const pages = new GetPublishedPageUseCase(new SupabasePageRepository());
  const publishedPages = await pages.listAll();

  return publishedPages
    .filter((page) => !page.isHome)
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const hero = page.blocks.find((block) => block.type === "hero_media");
const heroImage = hero?.media.kind === "image" ? hero.media.url : hero?.poster || hero?.media.posterUrl;
---

<SiteLayout title={page.seo.title} description={page.seo.description} heroImage={heroImage}>
  <BlockRenderer blocks={page.blocks} />
</SiteLayout>